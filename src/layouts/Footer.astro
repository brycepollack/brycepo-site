---
import { Icon } from 'astro-icon/components';
---

<footer>
  <div class="flex flex-wrap items-center justify-center gap-7">
    <a
      href="https://github.com/brycepollack"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <Icon name="mdi:github" class="text-xl" />
    </a>

    <a
      href="https://linkedin.com/in/brycepollack"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
    >
      <Icon name="mdi:linkedin" class="text-xl" />
    </a>

    <a
      href="https://discordapp.com/users/147954160526950411"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Discord"
    >
      <Icon name="ic:outline-discord" class="text-xl" />
    </a>

    <a
      href="mailto:bryce.pollack@gmail.com"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Email"
    >
      <Icon name="mdi:email" class="text-xl" />
    </a>
  </div>
  <p class="px-4 text-center text-xs text-muted">© 2026 Bryce Pollack. All rights reserved.</p>
</footer>
