---
import Layout from '@/layouts/Layout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import readingTime from 'reading-time';

interface Props {
  entry: CollectionEntry<'blog'> & {
    readingTime: { words: number; minutes: number };
  };
}

const { entry } = Astro.props;

const { Content, headings } = await entry.render();

export async function getStaticPaths() {
  const posts: CollectionEntry<'blog'>[] = await getCollection('blog');
  return posts.map(post => {
    const stats = readingTime(post.body);
    return {
      params: { slug: post.slug },
      props: {
        entry: {
          ...post,
          readingTime: {
            words: stats.words,
            minutes: Math.ceil(stats.minutes),
          },
        },
      },
    };
  });
}
---

<Layout title={`${entry.data.title} | Bryce Pollack`}>
  <div class="relative">
    <article>
      <h1>{entry.data.title}</h1>

      <div class="mb-4 flex items-center gap-4 text-sm text-muted">
        <span class="flex items-center gap-2">
          <Icon name="mdi:calendar-blank" class="icon" />
          {entry.data.pubDate}
        </span>

        <span class="flex items-center gap-2">
          <Icon name="mdi:pencil" class="icon" />
          {entry.readingTime.words} words
        </span>

        <span class="flex items-center gap-2">
          <Icon name="mdi:clock" class="icon" />
          {entry.readingTime.minutes} min read
        </span>
      </div>

      <Content />
    </article>

    <aside class="absolute top-0 left-[calc(100%+2.5rem)] hidden h-full w-55 min-[1100px]:block">
      {headings.length >= 1 && <TableOfContents headings={headings} />}
    </aside>
  </div>
</Layout>
