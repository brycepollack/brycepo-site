---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
---

<nav class="sticky top-20 text-sm leading-snug">
  <p class="mb-2 tracking-widest uppercase">Table of Contents</p>

  <ul>
    {
      headings.map(h => (
        <li class="mb-2">
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))
    }
  </ul>
</nav>
