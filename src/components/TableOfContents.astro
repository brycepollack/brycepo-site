---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

const depthClass: Record<number, string> = {
  1: 'mt-3 font-semibold',
  2: 'pl-2.5 font-medium',
  3: 'pl-5 opacity-75',
};
---

<nav class="sticky top-20 text-sm leading-snug">
  <h2 class="mb-2 tracking-widest uppercase opacity-55">Table of contents</h2>

  <ul>
    {
      headings.map(h => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={[
              'block opacity-65 transition-opacity duration-150 hover:opacity-100',
              depthClass[h.depth],
            ]}
          >
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
