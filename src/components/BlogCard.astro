---
interface Props {
  title: string;
  slug: string;
  date: string;
  description: string;
}

const { title, slug, date, description } = Astro.props;
---

<a
  href={`/blog/${slug}/`}
  class="block rounded-xl border border-text p-6 text-text transition-transform duration-200 ease-in-out hover:-translate-y-1"
>
  <h2 class="mb-2">{title}</h2>
  <p class="mb-2 text-sm">Published on {date}</p>
  <p>{description}</p>
</a>
